# Copy to .env for local development. NEVER commit .env.
# .env is gitignored; only this example file is tracked.

# --- LLM provider (agent orchestration layer) ---------------------------------
# Anthropic API key. Leave blank to run the agent in deterministic mode:
# the uplift model + policy engine still decide and audit every checkout.
ANTHROPIC_API_KEY=

# Model used by the orchestrator (e.g. claude-sonnet-5, claude-opus-5).
AGENT_MODEL=claude-sonnet-5

# Skip the LLM entirely (deterministic pipeline only).
AGENT_DISABLE_LLM=false

# Max tool-use round trips before the orchestrator finishes deterministically.
AGENT_MAX_TOOL_TURNS=6

# --- Reliability / failure demonstration --------------------------------------
# Wall-clock budget for one scoring call, in seconds.
MODEL_SCORING_TIMEOUT_SECONDS=30

# Force a scoring failure: "true" (error) or "timeout".
# SIMULATE_MODEL_FAILURE=true

# Force a policy-engine failure (exercises the last-resort 0% fallback).
# SIMULATE_POLICY_FAILURE=false

# Force an LLM failure (proves checkout survives without the LLM).
# SIMULATE_LLM_FAILURE=false
